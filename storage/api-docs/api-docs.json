{
    "openapi": "3.0.0",
    "info": {
        "title": "ReportesApi",
        "version": "0.1"
    },
    "paths": {
        "/api/company": {
            "get": {
                "tags": [
                    "Empresas"
                ],
                "operationId": "getCompanies",
                "responses": {
                    "200": {
                        "description": "Lista de empresas",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Company"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/company/{company}": {
            "get": {
                "tags": [
                    "Empresas"
                ],
                "operationId": "getCompanyById",
                "parameters": [
                    {
                        "name": "company",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Datos de la empresa",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Company"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "No encontrado"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Company": {
                "required": [
                    "name"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "Acme Inc."
                    }
                },
                "type": "object"
            }
        }
    },
    "tags": [
        {
            "name": "Empresas",
            "description": "Empresas"
        }
    ]
}